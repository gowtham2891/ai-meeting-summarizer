# ---------------------------------------------------------------------------
# Provider selection
# Leave both on "mock" to run the whole pipeline offline with zero credentials.
# ---------------------------------------------------------------------------
TRANSCRIBER=mock          # mock | sarvam
EXTRACTOR=mock            # mock | openai | gemini

# --- Sarvam AI (speech-to-text) -------------------------------------------
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v2.5

# --- LLM (extraction) ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2

# --- Delivery: email (SMTP) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=                 # comma separated

# --- Delivery: WhatsApp (Twilio) ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=              # comma separated, e.g. whatsapp:+919999999999

# --- Behaviour -------------------------------------------------------------
CHUNK_SECONDS=600
REQUEST_TIMEOUT=120
MAX_RETRIES=3
OUTPUT_DIR=output
